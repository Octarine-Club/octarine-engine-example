<OXML>
  <Style src="ui/theme.oss" />

  <Canvas fixed="true" base-layer="40">
    <Column width="100%" height="100%" padding="12px" gap="10px" justify="start" pointer-events="none">
      <!-- Top Navigation Bar -->
      <Row class="chrome-bar" width="100%" height="44px" align="center" justify="space-between" pointer-events="stop">
        <Row width="auto" height="32px" gap="10px" align="center">
          <Button class="btn" width="96px" height="30px" text="&lt; Hub [Esc]" on-click="onHub" />
          <Label text="{sceneTitle}" font="charriot-16" color="#eab308" width="auto" height="28px" text-valign="center" outline-color="#000000ff" outline-width="1px" />
        </Row>

        <Row width="auto" height="32px" gap="10px" align="center">
          <Label text="{nativeBadge}" font="arial-font-12" color="#38bdf8" width="auto" height="24px" text-valign="center" />
          <Label text="{perfText}" font="arial-font-12" color="#cbd5e1" width="auto" height="24px" text-valign="center" />
          <Button class="btn" width="92px" height="28px" text="Reset [F5]" on-click="onReset" />
          <Button class="btn" width="110px" height="28px" text="Wireframe [F2]" on-click="onToggleWireframes" />
          <Button class="btn" width="100px" height="28px" text="{guideBtnLbl}" on-click="onToggleGuide" />
        </Row>
      </Row>

      <!-- Top-Right Collapsible Controls & Paradigm Guide -->
      <Row width="100%" height="auto" justify="end" align="start" pointer-events="none">
        <Column if="{showGuide}" class="guide-panel" width="330px" height="auto" pointer-events="stop">
          <Label text="CONTROLS &amp; PARADIGMS" font="charriot-14" color="#38bdf8" width="100%" height="20px" />
          <Label text="{guideText}" font="arial-font-12" color="#e2e8f0" width="100%" height="auto" wrap="true" />
        </Column>
      </Row>
    </Column>
  </Canvas>
</OXML>
