<OXML>
  <Style src="ui/theme.oss" />

  <Canvas fixed="true" base-layer="30">
    <Column width="100%" height="100%" padding="12px" justify="end" pointer-events="none">
      <Row class="chrome-bar" width="auto" height="52px" align="center" gap="6px" pointer-events="stop">
        <Label text="Stitch:" font="arial-font-12" color="#94a3b8" width="auto" height="22px" text-valign="center" />
        <Button class="btn" width="84px" height="30px" text="Toroidal" on-click="onModeToroidal" />
        <Button class="btn" width="100px" height="30px" text="Procedural" on-click="onModeProcedural" />
        <Button class="btn" width="74px" height="30px" text="Arena" on-click="onModeArena" />
        <Button class="btn" width="88px" height="30px" text="New Seed" on-click="onRollSeed" />
        <Button class="btn" width="112px" height="30px" text="Override (0,0)" on-click="onToggleOverride" />
        <Button class="btn" width="102px" height="30px" text="Reset Props" on-click="onResetProps" />
        <Toggle class="toggle-btn" width="112px" height="30px" text="Tile Overlay" bind-value="debugOverlay" on-change="onToggleOverlay" />
        <Label text="{tileInfo}" font="arial-font-12" color="#38bdf8" width="auto" height="22px" text-valign="center" />
      </Row>
    </Column>
  </Canvas>
</OXML>
