<OXML>
  <Style src="ui/theme.oss" />
  <Use name="StatPill" src="ui/widgets/stat_pill.oxml" />

  <Canvas fixed="true" base-layer="25">
    <Column width="100%" height="100%" padding="14px 16px 16px 16px" gap="12px">
      <!-- Top spacer under shared chrome bar -->
      <Box width="100%" height="48px" />

      <!-- Three-Column Paradigm Matrix -->
      <Row width="100%" flex-grow="1" gap="14px">
        <!-- Column 1: Paradigm C (Reactive MVVM) + Settings -->
        <Column class="panel-surface" width="1fr" height="100%" padding="16px" gap="10px">
          <Label class="section-heading" text="1. REACTIVE MVVM + SETTINGS.*" width="100%" height="22px" />
          <Label class="muted-text" text="ui.observable() auto-syncs (expr) and bind-value controls." width="100%" height="auto" wrap="true" />

          <Row width="100%" height="30px" justify="space-between" align="center">
            <Label class="body-text" text="Volume: {volumePct}%" width="auto" height="22px" />
            <StatusBeacon title="ENGINE" status="{beaconStatus}" active="{not isMuted}" />
          </Row>
          <Slider class="slider-ctrl" width="100%" height="20px" min="0" max="100" step="5" bind-value="volumePct" color="#38bdf8" track-color="#0f172a" on-change="onVolumeChange" />

          <Toggle class="toggle-btn" width="100%" height="34px" text="Mute Master Audio" bind-value="isMuted" on-change="onMuteChange" />

          <Label class="body-text" text="Difficulty (settings.set / save):" width="100%" height="20px" />
          <RadioGroup bind-value="difficulty" on-change="onDifficultyChange" direction="row" gap="8px" width="100%" height="34px">
            <RadioButton class="toggle-btn" value="easy" text="Easy" width="1fr" height="32px" />
            <RadioButton class="toggle-btn" value="normal" text="Normal" width="1fr" height="32px" />
            <RadioButton class="toggle-btn" value="hard" text="Hard" width="1fr" height="32px" />
          </RadioGroup>

          <Label class="body-text" text="Reactor Power: {powerLevel}%" width="100%" height="20px" />
          <ProgressBar value="{powerLevel / 100}" width="100%" height="16px" color="#eab308" track-color="#0f172a" />
          <Slider class="slider-ctrl" width="100%" height="20px" min="0" max="100" step="5" bind-value="powerLevel" color="#eab308" track-color="#0f172a" />

          <Button class="btn-primary" width="100%" height="36px" text="Save user_settings.ini" on-click="onSaveSettings" />
          <Label class="muted-text" text="{settingsStatus}" width="100%" height="auto" wrap="true" />
        </Column>

        <!-- Column 2: Paradigm B (Data Context + Grid + ScrollView + Use/Slot) -->
        <Column class="panel-surface" width="1fr" height="100%" padding="16px" gap="10px">
          <Label class="section-heading" text="2. TEMPLATES, GRID &amp; SCROLLVIEW" width="100%" height="22px" />
          <Label class="muted-text" text="Demonstrates &lt;Use&gt;/&lt;Slot&gt;, &lt;Grid&gt;, &lt;ScrollView&gt;, and each repeaters." width="100%" height="auto" wrap="true" />

          <Grid columns="2" gap="8px" cross-gap="8px" width="100%" height="auto">
            <StatPill label="ACTIVE UNITS" value="{unitCount}" />
            <StatPill label="BEST SCORE" value="{bestScore}">
              <Label slot="badge" text="RECORD:" font="arial-font-12" color="#22c55e" width="auto" height="20px" />
            </StatPill>
          </Grid>

          <Row width="100%" height="34px" gap="8px">
            <Button class="btn" width="1fr" height="32px" text="+ Add Entry" on-click="onAddItem" />
            <Button class="btn" width="1fr" height="32px" text="Shuffle List" on-click="onShuffleItems" />
          </Row>

          <ScrollView width="100%" flex-grow="1" wheel-step="32">
            <Column width="100%" height="auto" gap="6px">
              <Row each="entry, idx in {roster}" class="card-surface" width="100%" height="36px" padding="0px 10px" align="center" justify="space-between">
                <Label text="#{idx} {entry.name}" font="arial-font-12" color="#f8fafc" width="auto" height="20px" />
                <Label text="{entry.role}" font="arial-font-12" color="#38bdf8" width="auto" height="20px" />
              </Row>
            </Column>
          </ScrollView>
        </Column>

        <!-- Column 3: Paradigm A (Imperative Refs, Outline, Inert Subtree, storage.*) -->
        <Column class="panel-surface" width="1fr" height="100%" padding="16px" gap="10px">
          <Label class="section-heading" text="3. REFS, INERT &amp; STORAGE.*" width="100%" height="22px" />
          <Label class="muted-text" text="Imperative view.refs handles, ref:set_outline, set_inert, and sandboxed storage." width="100%" height="auto" wrap="true" />

          <Column ref="inertGroup" class="card-surface" width="100%" height="auto" padding="12px" gap="8px">
            <Label ref="imperativeLabel" text="Imperative Ref Ready" font="charriot-16" color="#fde047" width="100%" height="26px" text-align="center" />
            <Button ref="pingBtn" class="btn" width="100%" height="34px" text="Mutate Text &amp; Outline via Ref" on-click="onPingRef" />
          </Column>

          <Row width="100%" height="34px" gap="8px">
            <Button class="btn" width="1fr" height="32px" text="Toggle Inert Subtree" on-click="onToggleInert" />
            <Button class="btn" width="1fr" height="32px" text="Test Modal Scrim" on-click="onOpenModal" />
          </Row>

          <Label class="section-heading" text="SANDBOXED SAVE STORAGE" width="100%" height="22px" />
          <Row width="100%" height="34px" gap="8px">
            <Button class="btn" width="1fr" height="32px" text="Write Note" on-click="onSaveNote" />
            <Button class="btn" width="1fr" height="32px" text="Read Note" on-click="onReadNote" />
            <Button class="btn" width="1fr" height="32px" text="Delete" on-click="onDeleteNote" />
          </Row>
          <Column class="card-surface" width="100%" flex-grow="1" padding="10px" gap="6px">
            <Label text="{storageOutput}" font="arial-font-12" color="#cbd5e1" width="100%" height="auto" wrap="true" />
          </Column>
        </Column>
      </Row>
    </Column>

    <!-- Modal Pointer-Blocking Scrim Demo -->
    <Box if="{modalOpen}" width="100%" height="100%" background-color="#00000099" pointer-events="stop">
      <Column class="panel-surface" width="420px" height="auto" padding="22px" gap="12px" anchor="center">
        <Label text="POINTER-BLOCKING MODAL" font="charriot-16" color="#eab308" width="100%" height="26px" text-align="center" />
        <Label text="pointer-events='stop' blocks clicks and scroll-wheel from reaching UI on lower layers." font="arial-font-14" color="#e2e8f0" width="100%" height="auto" wrap="true" />
        <Button class="btn-primary" width="100%" height="38px" text="Close Modal" key="return" on-click="onCloseModal" />
      </Column>
    </Box>
  </Canvas>
</OXML>
